# Server
PORT=5000
HOST=0.0.0.0
RELOAD=false
NODE_ENV=production

# Comma-separated allowed origins for CORS / Socket.IO (defaults to FRONTEND_URL, then "*")
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/weave_automation

# Weave Account Credentials
WEAVE_EMAIL=
WEAVE_PASSWORD=

# Browser automation
HEADLESS=true
SLOW_MO=100
DEFAULT_TIMEOUT=15000
SEARCH_TIMEOUT=20000
MESSAGE_LOAD_TIMEOUT=30000
