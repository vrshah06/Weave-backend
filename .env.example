# =========================================================================
# WEAVE AUTOMATION SAAS — PRODUCTION ENVIRONMENT CONFIGURATION
# =========================================================================

# Node / Environment
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Security & Workspace Secret
WORKSPACE_SECRET=your-secure-random-workspace-secret-key-2026

# MongoDB Atlas Database URI (External Cloud DB)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/weave_automation?retryWrites=true&w=majority

# Redis Job Queue Connection URL
REDIS_URL=redis://redis:6379

# Weave Account Credentials (Used by Python worker for auto-authentication)
WEAVE_EMAIL=clinic_admin@example.com
WEAVE_PASSWORD=YourSecureWeavePasswordHere

# Automation Settings
HEADLESS=true
SLOW_MO=0
LOG_LEVEL=INFO
