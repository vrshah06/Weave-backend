# --- Shared by API and worker ---
ENVIRONMENT=development
MONGODB_URI=mongodb://localhost:27017/weave_automation
TIME_ZONE=America/New_York
BUSINESS_NAME=MD Primary Care Inc.
LOG_LEVEL=INFO

# --- API ---
# Required. Clients send it as the X-API-Key header (or ?apiKey= for SSE/screenshots).
API_KEY=change-me
# Comma-separated allowed origins; defaults to FRONTEND_URL, then "*".
CORS_ORIGINS=http://localhost:3000

# --- Worker ---
WEAVE_EMAIL=
WEAVE_PASSWORD=
HEADLESS=true
BROWSER_PROFILE_DIR=./weave-profile
BROWSER_TIMEOUT_MS=20000
# Real SMS are only sent when this is true.
SENDING_ENABLED=false
